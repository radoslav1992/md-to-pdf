---
import '../styles/global.css';
import NavBar from '../components/NavBar.tsx';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Convert Markdown, HTML, JSON, CSV and more into beautifully styled documents — self-hosted, fast, joyful.',
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
const marketingLinks = [
  { href: '/editor', label: 'Editor' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/blog', label: 'Blog' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1915" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* Inter for UI/body, Newsreader for the editorial serif headlines —
        the closest open pairing to claude.ai's Styrene + Copernicus. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
    />
    <title>{title}</title>
    {/* Apply the persisted theme before first paint so we don't flash the
        opposite scheme. Falls back to the OS preference when nothing is set. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('udc-theme');
          var preferDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (preferDark ? 'dark' : 'light');
          if (theme === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    {/* Register the service worker so the static shell keeps loading when
        the network's out. Failures are silent — the SW is purely additive. */}
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body class="min-h-screen bg-cream-50 text-stone-900 flex flex-col antialiased dark:bg-ink-950 dark:text-stone-100">
    <header class="sticky top-0 z-40 bg-cream-50/80 backdrop-blur-md border-b border-stone-200/60 dark:bg-ink-900/80 dark:border-ink-700/70">
      <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 font-semibold text-base text-stone-900 hover:text-brand-700 transition">
          <span class="inline-flex w-8 h-8 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-glow text-sm font-bold">U</span>
          <span class="hidden sm:inline">Universal Converter</span>
        </a>

        <ul class="hidden md:flex items-center gap-1 ml-4 text-sm">
          {marketingLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  'px-3 py-1.5 rounded-lg transition',
                  isActive(l.href)
                    ? 'text-brand-700 bg-brand-100/70 font-medium'
                    : 'text-stone-600 hover:text-brand-700 hover:bg-stone-100',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="flex-1"></div>

        <NavBar client:load currentPath={pathname} />
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-stone-200/70 mt-16 bg-cream-50/60 dark:bg-ink-900/50 dark:border-ink-700/70">
      <div class="max-w-6xl mx-auto px-4 py-10 grid md:grid-cols-3 gap-8 text-sm">
        <div>
          <div class="flex items-center gap-2 font-semibold text-stone-900">
            <span class="inline-flex w-7 h-7 items-center justify-center rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-white text-xs font-bold">U</span>
            Universal Converter
          </div>
          <p class="mt-3 text-stone-600 max-w-xs leading-relaxed">
            Self-hosted document conversion that's quick to use and joyful to look at.
          </p>
        </div>
        <div>
          <h4 class="text-xs uppercase tracking-wider font-semibold text-stone-500 mb-3">Product</h4>
          <ul class="space-y-2 text-stone-700">
            <li><a href="/editor" class="hover:text-brand-700 transition">Editor</a></li>
            <li><a href="/pricing" class="hover:text-brand-700 transition">Pricing</a></li>
            <li><a href="/blog" class="hover:text-brand-700 transition">Blog</a></li>
            <li><a href="/api-docs" class="hover:text-brand-700 transition">API reference</a></li>
            <li><a href="/gallery" class="hover:text-brand-700 transition">Template gallery</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xs uppercase tracking-wider font-semibold text-stone-500 mb-3">Legal</h4>
          <ul class="space-y-2 text-stone-700">
            <li><a href="/legal/terms" class="hover:text-brand-700 transition">Terms</a></li>
            <li><a href="/legal/privacy" class="hover:text-brand-700 transition">Privacy</a></li>
            <li><a href="/legal" class="hover:text-brand-700 transition">All legal</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-stone-200/70">
        <p class="max-w-6xl mx-auto px-4 py-4 text-xs text-stone-500">
          &copy; {new Date().getFullYear()} Universal Document Converter
        </p>
      </div>
    </footer>
  </body>
</html>
