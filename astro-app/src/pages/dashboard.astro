---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocumentList from '../components/DocumentList.tsx';
---

<BaseLayout title="Dashboard — Universal Document Converter">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">Your documents</h1>
        <p class="mt-2 text-slate-600">Saved conversions. Click any to preview.</p>
      </div>
      <a
        href="/editor"
        class="bg-brand-600 hover:bg-brand-700 text-white font-medium px-4 py-2 rounded-md text-sm transition"
      >
        + New document
      </a>
    </div>
    <DocumentList client:load />
  </section>
</BaseLayout>
