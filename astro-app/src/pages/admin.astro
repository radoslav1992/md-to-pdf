---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminUserList from '../components/AdminUserList.tsx';
---

<BaseLayout title="Admin — Universal Document Converter">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-slate-900">Admin · Users</h1>
      <p class="mt-2 text-slate-600">
        Promote users to <strong>premium</strong> manually. Subscriptions will replace this flow
        later.
      </p>
    </div>
    <AdminUserList client:load />
  </section>
</BaseLayout>
