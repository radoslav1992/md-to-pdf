---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConverterEditor from '../components/ConverterEditor.tsx';
---

<BaseLayout title="Editor — Universal Document Converter">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">Editor</h1>
        <p class="mt-2 text-slate-600">
          Convert and save documents. Markdown is free; HTML, JSON, and XML are unlocked with
          a premium account.
        </p>
      </div>
      <a href="/dashboard" class="text-sm text-brand-600 hover:text-brand-700 underline">
        Your saved documents →
      </a>
    </div>
    <ConverterEditor client:load />
  </section>
</BaseLayout>
