---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForm from '../components/AuthForm.tsx';
---

<BaseLayout title="Sign up — Universal Document Converter">
  <section class="relative">
    <div class="absolute inset-0 bg-hero-warm pointer-events-none"></div>
    <div class="relative max-w-md mx-auto px-4 pt-16 pb-20">
      <div class="text-center">
        <h1 class="text-3xl font-bold tracking-tight text-stone-900">Create your account</h1>
        <p class="mt-2 text-sm text-stone-600">
          Free forever. Save your documents, unlock the dashboard, and pick up premium when you need it.
        </p>
      </div>
      <div class="mt-8 card p-6">
        <AuthForm mode="signup" client:load />
      </div>
      <p class="mt-6 text-xs text-stone-500 text-center">
        By signing up you agree to our
        <a href="/legal/terms" class="link">Terms</a>
        and
        <a href="/legal/privacy" class="link">Privacy Policy</a>.
      </p>
    </div>
  </section>
</BaseLayout>
