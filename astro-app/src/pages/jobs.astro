---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobList from '../components/JobList.tsx';
---

<BaseLayout title="Jobs — Universal Document Converter">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-slate-900">Background jobs</h1>
      <p class="mt-2 text-slate-600">
        Long-running conversions and batches run asynchronously on a worker. The list refreshes
        every 3 seconds.
      </p>
    </div>
    <JobList client:load />
  </section>
</BaseLayout>
