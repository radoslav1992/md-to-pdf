---
import BaseLayout from '../layouts/BaseLayout.astro';
import JobList from '../components/JobList.tsx';
---

<BaseLayout title="Jobs — Universal Document Converter">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="mb-6">
      <span class="pill-peach">Premium</span>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900">Background jobs</h1>
      <p class="mt-2 text-stone-600 max-w-2xl">
        Long-running conversions and batches run asynchronously on a worker. The list refreshes
        every 3 seconds.
      </p>
    </div>
    <JobList client:load />
  </section>
</BaseLayout>
