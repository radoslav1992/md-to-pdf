---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForm from '../components/AuthForm.tsx';
---

<BaseLayout title="Log in — Universal Document Converter">
  <section class="max-w-md mx-auto px-4 py-16">
    <h1 class="text-2xl font-bold text-slate-900 text-center">Log in</h1>
    <p class="mt-2 text-sm text-slate-600 text-center">
      Welcome back. Log in to access your saved documents.
    </p>
    <div class="mt-8 border border-slate-200 rounded-xl p-6 bg-white">
      <AuthForm mode="login" client:load />
    </div>
  </section>
</BaseLayout>
