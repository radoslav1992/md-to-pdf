---
import BaseLayout from '../layouts/BaseLayout.astro';
import TemplateList from '../components/TemplateList.tsx';
---

<BaseLayout title="Templates — Universal Document Converter">
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="mb-6">
      <span class="pill-peach">Premium</span>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900">Templates</h1>
      <p class="mt-2 text-stone-600 max-w-2xl">
        Save reusable styling bundles — theme, page setup, custom CSS — and apply them to any
        document with one click.
      </p>
    </div>
    <TemplateList client:load />
  </section>
</BaseLayout>
