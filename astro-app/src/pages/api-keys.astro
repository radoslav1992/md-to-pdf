---
import BaseLayout from '../layouts/BaseLayout.astro';
import ApiKeyList from '../components/ApiKeyList.tsx';
---

<BaseLayout title="API keys — Universal Document Converter">
  <section class="max-w-3xl mx-auto px-4 py-10">
    <div class="mb-6">
      <span class="pill-peach">Premium</span>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900">API keys</h1>
      <p class="mt-2 text-stone-600">
        Programmatic access for premium users. Each key is shown in full once and stored
        as a SHA-256 hash. Conversions count against your monthly quota.
      </p>
    </div>
    <ApiKeyList client:load />
  </section>
</BaseLayout>
