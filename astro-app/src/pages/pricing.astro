---
import BaseLayout from '../layouts/BaseLayout.astro';

const free = [
  'Markdown → HTML / PDF',
  '256 KB payloads',
  '100 conversions / month',
  'Save documents to dashboard',
  'Re-render anytime',
];

const premium = [
  { group: 'Inputs', items: ['HTML, JSON, XML, CSV', 'Org-mode, AsciiDoc, RST, LaTeX', '16 MB payloads + multi-file'] },
  { group: 'Output', items: ['6 themes + custom CSS', 'Reusable templates', 'Page setup, cover, header/footer, page numbers'] },
  { group: 'Enrichments', items: ['Auto table of contents', 'Server-side syntax highlighting', 'LaTeX math (KaTeX → MathML)'] },
  { group: 'Workflow', items: ['10,000 conversions / month', 'Batch conversion + signed webhooks', 'Background jobs for long batches'] },
  { group: 'Sharing & safety', items: ['Shareable links (password + expiry)', 'Version history with restore', 'AES-256-GCM encryption at rest'] },
  { group: 'Integration', items: ['API keys (Bearer tokens)', 'PDF → Markdown (with OCR)'] },
];
---

<BaseLayout title="Pricing — Universal Document Converter">
  <section class="relative">
    <div class="absolute inset-0 bg-hero-warm pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-4 pt-16 md:pt-20 pb-8 text-center">
      <span class="pill-brand">Pricing</span>
      <h1 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight text-stone-900">Simple, transparent pricing</h1>
      <p class="mt-4 text-lg text-stone-600 max-w-2xl mx-auto">
        Free for everyone. Upgrade when you want templates, API access, and joyful little extras.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-20">
    <div class="grid md:grid-cols-3 gap-5">
      <!-- Anonymous -->
      <div class="card p-7 flex flex-col">
        <h2 class="text-lg font-semibold text-stone-900">Anonymous</h2>
        <p class="mt-1 text-sm text-stone-500">No account needed</p>
        <div class="mt-5 flex items-baseline gap-1">
          <span class="text-4xl font-bold text-stone-900">$0</span>
        </div>
        <ul class="mt-6 space-y-2.5 text-sm text-stone-700 text-left flex-1">
          <li class="flex items-start gap-2"><span class="check">✓</span> Markdown → HTML / PDF</li>
          <li class="flex items-start gap-2"><span class="check">✓</span> 256 KB payloads</li>
          <li class="flex items-start gap-2 text-stone-400 line-through"><span class="dash">·</span> Save documents</li>
        </ul>
        <a href="/editor" class="btn-secondary mt-6">Try it now</a>
      </div>

      <!-- Free -->
      <div class="card p-7 flex flex-col bg-cream-50">
        <h2 class="text-lg font-semibold text-stone-900">Free account</h2>
        <p class="mt-1 text-sm text-stone-500">For personal use</p>
        <div class="mt-5 flex items-baseline gap-1">
          <span class="text-4xl font-bold text-stone-900">$0</span>
        </div>
        <ul class="mt-6 space-y-2.5 text-sm text-stone-700 text-left flex-1">
          {free.map((f) => (
            <li class="flex items-start gap-2"><span class="check">✓</span> {f}</li>
          ))}
        </ul>
        <a href="/signup" class="btn-primary mt-6">Create account</a>
      </div>

      <!-- Premium -->
      <div class="relative md:scale-[1.02] rounded-2xl p-[2px] bg-gradient-to-br from-brand-500 via-brand-600 to-peach-500 shadow-glow">
        <div class="border-0 p-7 flex flex-col h-full bg-white rounded-[14px]">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gradient-to-r from-peach-500 to-peach-600 text-white text-[10px] uppercase tracking-wider font-bold px-3 py-1 rounded-full shadow-peach">
            ✨ Most popular
          </span>
          <h2 class="text-lg font-semibold text-stone-900">Premium</h2>
          <p class="mt-1 text-sm text-stone-500">For power users + small teams</p>
          <div class="mt-5 flex items-baseline gap-1">
            <span class="text-4xl font-bold text-stone-900">$9</span>
            <span class="text-stone-500 text-sm">/mo</span>
          </div>
          <p class="mt-1 text-xs text-stone-500">Everything in Free, plus:</p>
          <div class="mt-5 space-y-4 text-left flex-1">
            {premium.map((g) => (
              <div>
                <h3 class="text-[11px] uppercase tracking-wider font-semibold text-stone-500 mb-1.5">{g.group}</h3>
                <ul class="space-y-1.5 text-sm text-stone-700">
                  {g.items.map((item) => (
                    <li class="flex items-start gap-2"><span class="check">✓</span> {item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <a href="/signup?plan=premium" class="btn-peach mt-6">Start premium</a>
          <p class="mt-3 text-[11px] text-stone-500 text-center">
            Currently free during beta — admins grant manually from <a href="/admin" class="link">/admin</a>.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-14 max-w-2xl mx-auto text-center">
      <h3 class="text-sm font-semibold text-stone-900">Need more?</h3>
      <p class="mt-1 text-sm text-stone-600">
        Custom quotas, on-prem deployment help, or invoiced billing — drop us a line at
        <a href="mailto:support@example.com" class="link">support@example.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .check {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #14b8a6, #0f766e);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    line-height: 1;
    margin-top: 0.15rem;
    font-weight: 700;
  }
  .dash {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #a8a29e;
    margin-top: 0.15rem;
  }
</style>
