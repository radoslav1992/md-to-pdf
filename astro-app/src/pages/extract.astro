---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExtractTool from '../components/ExtractTool.tsx';
---

<BaseLayout title="PDF → Markdown — Universal Document Converter">
  <section class="max-w-4xl mx-auto px-4 py-10">
    <div class="mb-6">
      <span class="pill-peach">Premium</span>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900">PDF → Markdown</h1>
      <p class="mt-2 text-stone-600 max-w-2xl">
        Upload a PDF and get back markdown. Text-based PDFs are extracted with
        <code class="font-mono text-sm bg-stone-100 px-1.5 py-0.5 rounded">pdftotext</code>;
        scanned/image PDFs fall back to OCR (Tesseract).
      </p>
    </div>
    <div class="card p-5">
      <ExtractTool client:load />
    </div>
  </section>
</BaseLayout>
