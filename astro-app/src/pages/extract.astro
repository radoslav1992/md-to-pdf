---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExtractTool from '../components/ExtractTool.tsx';
---

<BaseLayout title="PDF → Markdown — Universal Document Converter">
  <section class="max-w-4xl mx-auto px-4 py-10">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-slate-900">PDF → Markdown</h1>
      <p class="mt-2 text-slate-600">
        Upload a PDF and get back markdown. Text-based PDFs are extracted with
        <code class="font-mono text-sm">pdftotext</code>; scanned/image PDFs fall back to
        OCR (Tesseract). Premium only.
      </p>
    </div>
    <ExtractTool client:load />
  </section>
</BaseLayout>
