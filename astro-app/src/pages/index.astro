---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Universal Document Converter — Markdown, HTML, JSON, XML to PDF">
  <section class="max-w-6xl mx-auto px-4 py-16 md:py-24">
    <div class="text-center max-w-3xl mx-auto">
      <span class="inline-block bg-brand-50 text-brand-700 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wide">Edge-rendered · Rust · Cloudflare</span>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mt-4 text-slate-900">
        Convert any document format. <span class="text-brand-600">In milliseconds.</span>
      </h1>
      <p class="mt-6 text-lg text-slate-600">
        A single API for Markdown, HTML, JSON, and XML. Normalize, transform, and render to PDF —
        all from a Rust worker running at the edge.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/editor" class="bg-brand-600 hover:bg-brand-700 text-white font-medium px-6 py-3 rounded-lg transition">
          Try the editor
        </a>
        <a href="/blog" class="border border-slate-300 hover:border-slate-400 text-slate-800 font-medium px-6 py-3 rounded-lg transition">
          Read the blog
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-20">
    <div class="grid md:grid-cols-3 gap-6">
      <div class="border border-slate-200 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-slate-900">Universal input</h3>
        <p class="mt-2 text-slate-600 text-sm">
          Send Markdown, HTML, JSON, or XML. The Rust engine normalizes each format
          to a common intermediate representation before rendering.
        </p>
      </div>
      <div class="border border-slate-200 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-slate-900">Edge-native</h3>
        <p class="mt-2 text-slate-600 text-sm">
          Compiled to WebAssembly with the <code class="text-xs bg-slate-100 px-1 rounded">worker</code> crate.
          No cold starts, no servers, near-zero latency.
        </p>
      </div>
      <div class="border border-slate-200 rounded-xl p-6">
        <h3 class="text-lg font-semibold text-slate-900">PDF rendering</h3>
        <p class="mt-2 text-slate-600 text-sm">
          Dispatches HTML to an external headless-browser service for accurate PDF output —
          configurable and BYO-able.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
