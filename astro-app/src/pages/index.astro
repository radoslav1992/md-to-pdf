---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConverterEditor from '../components/ConverterEditor.tsx';
import Feature from '../components/Feature.astro';
---

<BaseLayout title="Universal Document Converter — Markdown, HTML, CSV, and more to beautiful PDFs">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-hero-warm pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-4 pt-16 md:pt-24 pb-10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-2 bg-white border border-stone-200/80 text-stone-700 text-xs font-medium px-3 py-1.5 rounded-full shadow-soft dark:bg-ink-800 dark:border-ink-700 dark:text-stone-300">
          <span class="inline-flex w-1.5 h-1.5 rounded-full bg-success-500 animate-pulse"></span>
          Self-hosted · No tracking · Free for everyone
        </span>
        <h1 class="font-serif font-medium text-5xl md:text-7xl tracking-tight mt-6 text-stone-900 leading-[1.05]">
          Documents that feel
          <span class="text-brand-600 dark:text-brand-400 italic">considered.</span>
        </h1>
        <p class="mt-6 text-lg md:text-xl text-stone-600 leading-relaxed max-w-2xl mx-auto">
          Convert Markdown, HTML, CSV, LaTeX and five more formats into clean,
          beautifully typeset PDFs. Save your work, pick a theme, automate with
          API keys — all from one calm, tidy workspace.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="#try" class="btn-primary text-base px-5 py-2.5">Try the editor ↓</a>
          <a href="/signup" class="btn-secondary text-base px-5 py-2.5">Create free account</a>
        </div>
      </div>
    </div>
  </section>

  <section id="try" class="max-w-6xl mx-auto px-4 pb-12 -mt-2">
    <div class="card p-4 md:p-6">
      <ConverterEditor anonymousMode={true} client:load />
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="pill-brand">Why people upgrade</span>
      <h2 class="mt-3 font-serif font-medium text-3xl md:text-4xl text-stone-900">Everything you need, none of the bloat</h2>
      <p class="mt-3 text-stone-600">Built around the conversions you actually do, with small delights along the way.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <Feature
        emoji="📥"
        title="9 input formats"
        body="Markdown, HTML, JSON, XML, CSV, Org, AsciiDoc, RST, LaTeX — all into HTML or PDF."
      />
      <Feature
        emoji="🎨"
        title="6 themes + custom CSS"
        body="From academic papers to slick resumes. Build reusable templates for recurring documents."
      />
      <Feature
        emoji="📐"
        title="Full PDF page setup"
        body="Page size, orientation, margins, page numbers, cover pages, headers and footers."
      />
      <Feature
        emoji="✨"
        title="TOC, math, syntax highlighting"
        body="Auto table of contents, LaTeX math → MathML, server-side syntect colors — premium opt-ins."
      />
      <Feature
        emoji="⚡"
        title="API keys + batch + webhooks"
        body="10,000 conversions/month. Signed HMAC webhooks. Background jobs for 50-doc batches."
      />
      <Feature
        emoji="🔐"
        title="Encrypted at rest"
        body="AES-256-GCM under a key only you know. Version history. Password-protected share links."
      />
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="card bg-gradient-to-br from-brand-600 to-brand-800 text-white p-8 md:p-12 text-center shadow-glow border-0">
      <h2 class="font-serif font-medium text-3xl md:text-4xl tracking-tight">Ready to upgrade your document workflow?</h2>
      <p class="mt-3 text-brand-100 max-w-2xl mx-auto">
        Start free, save documents to your dashboard, and pick up premium when you need
        templates, API access, or background jobs.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a href="/signup" class="btn-peach text-base px-5 py-2.5">Create a free account</a>
        <a href="/pricing" class="text-white/90 hover:text-white underline-offset-4 hover:underline px-3 py-2">
          See full pricing →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
