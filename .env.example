# Copy to `.env` and edit before running `docker compose up`.

# Comma-separated emails auto-promoted to admin on signup.
ADMIN_EMAILS=admin@example.com

# Set to "true" once you have a domain with TLS in front of Caddy.
# Leave "false" while serving over plain HTTP on the bare IP.
COOKIE_SECURE=false

# axum/tower-http log level: info, debug, trace
RUST_LOG=info

# In-memory render cache cap, in bytes. 0 disables the cache. Defaults to
# 128 MiB; bump on larger boxes if you have many repeat conversions.
# RENDER_CACHE_MAX_BYTES=134217728
