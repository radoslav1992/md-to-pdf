{
  "name": "universal-document-converter",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Document Converter SaaS - Astro frontend + Rust Worker backend on Cloudflare",
  "workspaces": [
    "astro-app"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:astro dev:worker",
    "dev:astro": "npm --workspace astro-app run dev",
    "dev:worker": "cd rust-backend && wrangler dev",
    "build": "npm-run-all build:worker build:astro",
    "build:astro": "npm --workspace astro-app run build",
    "build:worker": "cd rust-backend && cargo build --release --target wasm32-unknown-unknown",
    "deploy": "npm-run-all build:worker deploy:astro deploy:worker",
    "deploy:astro": "npm --workspace astro-app run deploy",
    "deploy:worker": "cd rust-backend && wrangler deploy",
    "preview": "npm --workspace astro-app run preview",
    "clean": "rm -rf astro-app/dist astro-app/.astro rust-backend/target node_modules astro-app/node_modules"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
